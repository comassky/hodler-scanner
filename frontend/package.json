{
  "name": "smm-frontend",
  "private": true,
  "version": "1.2.1-SNAPSHOT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "gen:openapi": "python3 ../backend/export_openapi.py",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/types/api.d.ts",
    "gen:api": "pnpm gen:openapi && pnpm gen:types"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "@vueuse/core": "^14.4.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "ofetch": "^1.5.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.7.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.2.0"
  }
}
